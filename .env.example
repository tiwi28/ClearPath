DATABASE_URL=postgresql://postgres:clearpath@localhost:5432/clearpath
ORS_API_KEY=
BARRIER_SOURCE=fixtures
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=/api
WEB_PORT=5173
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Routing server. Default is the public ORS; for the local one (docker compose --profile ors up -d)
# use ORS_BASE_URL=http://ors:8082/ors/v2
ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
# If ORS walking or wheelchair routing times out or errors, plans use this profile instead for 5 minutes
# (avoids stairs, but kerbs and slopes aren't checked; each plan says so). Empty turns it off.
ORS_FALLBACK_PROFILE=foot-hiking
# true sends every walking and wheelchair request to the fallback profile.
ORS_FORCE_FALLBACK=false
# Only needed to run `make ward-summaries`; the API itself never calls Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
